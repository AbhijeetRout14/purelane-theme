{% comment %}
  sections/bundles.liquid
  Tiers are homepage-only marketing copy (not reused elsewhere), so these are
  plain section blocks rather than metaobjects — see build notes for why that's
  a different call than combos.liquid.
{% endcomment %}

<div class="pl-scope">
  <section class="pl-sec" id="bundles" data-section-id="{{ section.id }}">
    <div class="pl-wrap">
      <div class="pl-glass pl-rv" style="padding:clamp(26px,3.4vw,40px);margin-bottom:16px">
        <div class="pl-panel-head" style="margin-bottom:0">
          {% if section.settings.kicker != blank %}
            <span class="pl-kicker">{{ section.settings.kicker }}</span>
          {% endif %}

          <h2 class="pl-d2">{{ section.settings.heading }}</h2>

          {% if section.settings.lede != blank %}
            <p class="pl-lede" style="margin:0 auto">{{ section.settings.lede }}</p>
          {% endif %}
        </div>
      </div>

      <div class="pl-tiers">
        {% for block in section.blocks %}
          {% if block.type == 'tier' %}
            <article
              class="pl-glass pl-tier pl-rv {% if block.settings.featured %}pl-best{% endif %}"
              {{ block.shopify_attributes }}
            >
              {% if block.settings.tag != blank %}
                <span class="pl-tag">{{ block.settings.tag }}</span>
              {% endif %}

              <div class="pl-qty">
                {{ block.settings.product_count }}
                <small>Products</small>
              </div>

              <div class="pl-price">
                {{ block.settings.price }}
                {% if block.settings.compare_price != blank %}
                  <s>{{ block.settings.compare_price }}</s>
                {% endif %}
              </div>

              {% if block.settings.per_product_note != blank %}
                <p style="font-size:12px;color:var(--pl-paper-2)">
                  {{ block.settings.per_product_note }}
                </p>
              {% endif %}

              {% if block.settings.features != blank %}
                <ul>
                  {% assign feature_lines = block.settings.features | newline_to_br | split: '<br />' %}

                  {% for line in feature_lines %}
                    {% if line != blank %}
                      <li>
                        {% render 'icon', name: 'check' %}
                        {{ line | strip }}
                      </li>
                    {% endif %}
                  {% endfor %}
                </ul>
              {% endif %}

              <a
                class="pl-btn {% if block.settings.featured %}pl-btn-primary{% else %}pl-btn-ghost{% endif %}"
                href="{{ block.settings.cta_link | default: '#shop' }}"
              >
                {{ block.settings.cta_text | default: 'Build this box' }}

                {% if block.settings.featured %}
                  {% render 'icon', name: 'arrow-right' %}
                {% endif %}
              </a>
            </article>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Bundles",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Build your bundle"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "One box. Every room."
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Supporting text"
    }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Pricing tier",
      "settings": [
        {
          "type": "text",
          "id": "tag",
          "label": "Tag",
          "default": "Starter"
        },
        {
          "type": "number",
          "id": "product_count",
          "label": "Product count",
          "default": 2
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price (formatted)",
          "default": "₹349"
        },
        {
          "type": "text",
          "id": "compare_price",
          "label": "Compare-at price (formatted)",
          "default": "₹598"
        },
        {
          "type": "text",
          "id": "per_product_note",
          "label": "Per-product note",
          "default": "Flat ₹174 per product"
        },
        {
          "type": "textarea",
          "id": "features",
          "label": "Feature list (one per line)",
          "default": "Pick any two products\nFree shipping across India"
        },
        {
          "type": "text",
          "id": "cta_text",
          "label": "Button label",
          "default": "Build this box"
        },
        {
          "type": "url",
          "id": "cta_link",
          "label": "Button link"
        },
        {
          "type": "checkbox",
          "id": "featured",
          "label": "Highlight as most popular",
          "default": false
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Bundles",
      "blocks": [
        {
          "type": "tier",
          "settings": {
            "tag": "Starter",
            "product_count": 2,
            "price": "₹349",
            "compare_price": "₹598",
            "per_product_note": "Flat ₹174 per product"
          }
        },
        {
          "type": "tier",
          "settings": {
            "tag": "Most popular",
            "product_count": 3,
            "price": "₹499",
            "compare_price": "₹897",
            "per_product_note": "Flat ₹166 per product",
            "featured": true
          }
        },
        {
          "type": "tier",
          "settings": {
            "tag": "Whole home",
            "product_count": 5,
            "price": "₹799",
            "compare_price": "₹1,495",
            "per_product_note": "Flat ₹160 per product"
          }
        }
      ]
    }
  ]
}
{% endschema %}