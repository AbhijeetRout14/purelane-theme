{% comment %}
  sections/combos.liquid
  Each block references a `combo` metaobject (title, flag, products list,
  description, cta_label — see metaobjects/combo.json for the definition
  to create in Settings > Custom data before this section will render blocks).
  Price / compare-price / savings are SUMMED from the referenced products'
  real variant prices — never typed in — so they can't drift from the catalog.
{% endcomment %}

<div class="pl-scope">
<section class="pl-sec" id="combos" data-section-id="{{ section.id }}">
  <div class="pl-wrap">
    <div class="pl-panel-head pl-rv">
      {% if section.settings.kicker != blank %}<span class="pl-kicker">{{ section.settings.kicker }}</span>{% endif %}
      <h2 class="pl-d2">{{ section.settings.heading }}</h2>
      <div class="pl-rule"><i></i>{% render 'icon', name: 'leaf' %}<i></i></div>
      {% if section.settings.lede != blank %}<p class="pl-lede" style="margin:14px auto 0">{{ section.settings.lede }}</p>{% endif %}
    </div>

    <div class="pl-comborail pl-rv" role="list">
      {% for block in section.blocks %}
        {% if block.type == 'combo' and block.settings.combo_ref != blank %}
          {%- assign combo = block.settings.combo_ref -%}
          {%- assign price_total = 0 -%}
          {%- assign compare_total = 0 -%}
          <article class="pl-glass pl-combo {% if combo.featured %}pl-featured{% endif %}" role="listitem" {{ block.shopify_attributes }}>
            <div class="pl-tray">
              {% if combo.flag != blank %}<span class="pl-flag">{{ combo.flag }}</span>{% endif %}
              <div class="pl-stack">
                {% for product in combo.products.value %}
                  {%- assign price_total = price_total | plus: product.selected_or_first_available_variant.price -%}
                  {%- assign compare_total = compare_total | plus: product.selected_or_first_available_variant.compare_at_price | default: product.selected_or_first_available_variant.price -%}
                  <span class="pl-it">
                    {% if product.featured_media %}
                      <img src="{{ product.featured_media | image_url: width: 132 }}" alt="{{ product.title | escape }}" loading="lazy" width="66" height="66">
                    {% endif %}
                    <span>{{ product.title }}</span>
                  </span>
                  {% unless forloop.last %}<span class="pl-plus" aria-hidden="true">+</span>{% endunless %}
                {% endfor %}
              </div>
            </div>
            <div class="pl-body">
              <h3>{{ combo.title }}</h3>
              <div class="pl-cnt">{{ combo.products.value.size }} products</div>
              {% if combo.description != blank %}<p class="pl-inc">{{ combo.description }}</p>{% endif %}
              <div class="pl-prow">
                <strong>{{ price_total | money }}</strong>
                {% if compare_total > price_total %}
                  <s>{{ compare_total | money }}</s>
                  <em>Save {{ compare_total | minus: price_total | money }}</em>
                {% endif %}
              </div>
              <div class="pl-fine">Inclusive of all taxes · COD available</div>
              <a class="pl-btn {% if combo.featured %}pl-btn-primary{% else %}pl-btn-ghost{% endif %}" href="{{ section.settings.bundle_anchor | default: '#bundles' }}">
                {{ block.settings.cta_label | default: 'Shop bundle' }}
                {% render 'icon', name: 'arrow-right' %}
              </a>
            </div>
          </article>
        {% endif %}
      {% endfor %}
    </div>

    <div class="pl-swipecue" aria-hidden="true">{% render 'icon', name: 'arrow-right' %}Swipe for more combos</div>
    {% if section.settings.rail_note != blank %}<p class="pl-railnote">{{ section.settings.rail_note }}</p>{% endif %}
  </div>
</section>
</div>

{% schema %}
{
  "name": "Best-selling combos",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Pre-built to save you money" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best selling combos" },
    { "type": "textarea", "id": "lede", "label": "Supporting text" },
    { "type": "text", "id": "bundle_anchor", "label": "CTA link target", "default": "#bundles" },
    { "type": "text", "id": "rail_note", "label": "Note below the rail", "default": "Tapping \"Shop bundle\" opens the bundle picker with these products already added." }
  ],
  "blocks": [
    {
      "type": "combo",
      "name": "Combo",
      "settings": [
        { "type": "metaobject", "id": "combo_ref", "metaobject_type": "combo", "label": "Combo" },
        { "type": "text", "id": "cta_label", "label": "CTA button label", "default": "Shop bundle" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "Best-selling combos" }]
}
{% endschema %}
