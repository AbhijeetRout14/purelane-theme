{% comment %}
  sections/shop-grid.liquid
  Repeating unit here is real catalog data, not curated marketing content —
  so this section takes a collection + limit, not blocks. See product-card.liquid
  for the shared card markup (also used inside sections/combos.liquid).
{% endcomment %}

<div class="pl-scope">
  <section class="pl-sec" id="shop" data-section-id="{{ section.id }}">
    <div class="pl-wrap">
      <div class="pl-panel-head pl-rv">
        {% if section.settings.kicker != blank %}
          <span class="pl-kicker">{{ section.settings.kicker }}</span>
        {% endif %}

        <h2 class="pl-d2">{{ section.settings.heading }}</h2>

        <div class="pl-rule">
          <i></i>
          {% render 'icon', name: 'leaf' %}
          <i></i>
        </div>
      </div>

      <div class="pl-shelf">
        {%- assign collection = collections[section.settings.collection] -%}

        {%- if collection != blank -%}
          {%- for product in collection.products limit: section.settings.product_limit -%}
            {%- assign stagger = forloop.index0 | modulo: 4 -%}
            {%- assign reveal_class = 'pl-rv-d' | append: stagger -%}

            {% render 'product-card', product: product, reveal_class: reveal_class %}
          {%- endfor -%}
        {%- else -%}
          <p class="pl-lede">
            Select a collection in the theme editor to populate this grid.
          </p>
        {%- endif -%}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Shop grid",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Bestsellers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by 30,000 homes"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Products to show",
      "min": 4,
      "max": 16,
      "step": 1,
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Shop grid"
    }
  ]
}
{% endschema %}